ext":"angela\u0027s definition for the people too lazy to watch:\nGrit is passion and perseverance for very long term goals. Grit is having stamina. Grit is sticking with your future, day in, day out, not just for the week, not just for the month, but for years, and working really hard to make that future a reality. Grit is living life like it\u0027s a marathon, not a sprint.","author":{"@type":"https://schema.org/Person","name":"@gianna9034","url":"https://www.youtube.com/@gianna9034","alternateName":"gianna"},"upvoteCount":4910}]}</script><script nonce="YCJ96qGDvSYpC_DemgQIcQ">if (window.ytcsi) {window.ytcsi.tick('bc', null, '');}</script><script nonce="YCJ96qGDvSYpC_DemgQIcQ">var ytimg={count:0,preload:function(src){var img=new Image;var count=++ytimg.count;ytimg[count]=img;img.onload=img.onerror=function(){delete ytimg[count]};img.src=src}};
